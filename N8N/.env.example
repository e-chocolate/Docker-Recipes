# ==============================================================================
# n8n Docker Compose Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 镜像版本配置 / Versions
# ------------------------------------------------------------------------------
# n8n 镜像版本：可设置为 latest 或指定的 Release Tag
# 查看最新版本：https://github.com/n8n-io/n8n/releases
N8N_VERSION=latest

# 沙箱服务版本：API、Runner 和 Sandbox 共享此版本号
# 查看最新版本：https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=1.3.4

# ------------------------------------------------------------------------------
# 2. n8n 基础配置 / n8n
# ------------------------------------------------------------------------------
# n8n 监听地址和端口
N8N_HOST_BIND_ADDRESS=127.0.0.1
N8N_HOST_PORT=5678
TZ=Asia/Shanghai
GENERIC_TIMEZONE=Asia/Shanghai
N8N_ENCRYPTION_KEY=change-me-encryption-key

# 数据库配置 / Database
# n8n 默认使用内置 SQLite（无需配置，开箱即用，数据持久化保存在 n8n_data 卷中）。
# 如需连接 PostgreSQL 数据库，请取消以下注释并配置：
# - 若连接宿主机上的 Postgres：HOST 请填写 host.docker.internal
# - 若连接局域网/公网独立 Postgres：HOST 请填写对应 IP 或域名
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=host.docker.internal
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n_user
# DB_POSTGRESDB_PASSWORD=change-me-postgres-password
# DB_POSTGRESDB_SSL_ENABLED=true
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true # 自签名证书请设为 false

# 任务执行器配置
# 外部 Task Runner 模式
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
# Task Runner 认证密钥
N8N_RUNNERS_AUTH_TOKEN=change-me-runner-auth-token

# 主服务配置
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_RUNNERS_TASK_TIMEOUT=60
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

# ------------------------------------------------------------------------------
# 3. n8n Assistant (AI 助手) 与安全沙箱 / Sandbox Service
# ------------------------------------------------------------------------------
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
# 沙箱 API 密钥（统一供 sandbox-api 验证与 n8n 主服务调用）
SANDBOX_API_KEYS=change-me-sandbox-api-key

# ------------------------------------------------------------------------------
# 4. AI 沙箱 Runner 注册与认证 / Sandbox Runner Registration & Authentication
# ------------------------------------------------------------------------------
# 沙箱 Runner 向 API 注册 Token
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-runner-registration-token
# 沙箱 Runner 与 API 通信密钥
SANDBOX_API_RUNNER_API_KEY=change-me-runner-api-key

# ------------------------------------------------------------------------------
# 5. 联网搜索配置 (SearXNG / Brave Search)
# ------------------------------------------------------------------------------
# 内置 SearXNG 服务秘钥
SEARXNG_SECRET=change-me-searxng-secret
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# ------------------------------------------------------------------------------
# 6. 可选：工具/模型提供商 API Key / SEARCH & AI Model Provider
# ------------------------------------------------------------------------------
# Brave Search API Key
INSTANCE_AI_BRAVE_SEARCH_API_KEY=
# 例如 Claude / OpenAI 等 API Key
N8N_ENABLED_MODULES=instance-ai
N8N_INSTANCE_AI_MODEL=deepseek-flash
N8N_INSTANCE_AI_MODEL_URL=https://api.deepseek.com
N8N_INSTANCE_AI_MODEL_API_KEY=
